{
  "opencollection": "1.0.0",
  "info": {
    "name": "Crossmint Wallets Balances NFTs API",
    "version": "2025-06-09"
  },
  "request": {
    "auth": {
      "type": "apikey",
      "key": "X-API-KEY",
      "value": "{{X-API-KEY}}",
      "placement": "header"
    }
  },
  "items": [
    {
      "info": {
        "name": "NFTs",
        "type": "folder"
      },
      "items": [
        {
          "info": {
            "name": "List wallet NFTs",
            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://www.crossmint.com/api/2025-06-09/wallets/:walletLocator/nfts",
            "params": [
              {
                "name": "walletLocator",
                "value": "",
                "type": "path"
              }
            ]
          },
          "docs": "List wallet NFTs"
        }
      ]
    }
  ],
  "bundled": true
}